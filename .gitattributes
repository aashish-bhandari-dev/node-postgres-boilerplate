# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code & Configuration files
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.env* text eol=lf
*.sh text eol=lf

# Executable shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Package lock files (collapse in diffs if supported)
package-lock.json -diff
