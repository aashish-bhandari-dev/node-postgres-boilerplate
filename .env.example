# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN=*

# PostgreSQL & Prisma Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_boilerplate_dev?schema=public

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging level: 'error' | 'warn' | 'info' | 'http' | 'debug'
LOG_LEVEL=debug

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Authentication Verification Toggles
# Set to 'true' to require email/phone verification for login and protected operations
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_PHONE_VERIFICATION=false

# Account Security & Lockout
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_EMAIL_TOKEN_EXPIRES_HOURS=24
AUTH_OTP_EXPIRES_MINUTES=10
