# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN=*

# PostgreSQL & Prisma Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_boilerplate_dev?schema=public

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging level: 'error' | 'warn' | 'info' | 'http' | 'debug'
LOG_LEVEL=debug
